# 数据库连接：容器内用 db 作为主机名；本机调试改成 localhost
DATABASE_URL=postgresql+psycopg2://docqa:docqa@db:5432/docqa
POSTGRES_PASSWORD=docqa

# JWT 密钥，上线必须换成长随机串
JWT_SECRET=please-change-this-to-a-long-random-string
JWT_TTL_MINUTES=720

# embedding / llm 提供方：mock（无需 Key，仅联调）或 openai（兼容接口）
EMBEDDING_PROVIDER=mock
LLM_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# 检索与拒答（阈值按 mock 向量标定，换成真实模型后必须重跑 eval_qa.py 重新标定）
RETRIEVE_TOP_K=5
ANSWER_THRESHOLD=0.20

# 切分参数（按字符，不是 token）
CHUNK_SIZE=300
CHUNK_OVERLAP=50
MAX_UPLOAD_MB=20
